# Optional: point the browser at the backend directly (requires credentialed CORS
# for the exact frontend origin). Leave unset in development to use the Vite dev
# proxy below, which keeps session cookies first-party.
# VITE_API_BASE_URL=http://localhost:8080

# Dev-server proxy target for /api and the /host API paths.
VITE_API_PROXY_TARGET=http://localhost:8080
